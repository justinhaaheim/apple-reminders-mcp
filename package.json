{
  "name": "apple-reminders-mcp",
  "description": "MCP server for Apple Reminders on macOS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "swift build -c release",
    "build:debug": "swift build",
    "build:universal": "bun scripts/build-universal.ts",
    "build:npm": "bun scripts/build-universal.ts --check",
    "reminders": "AR_SNAPSHOT_ENABLED=1 swift run reminders",
    "run": ".build/release/apple-reminders-mcp",
    "run:cli": ".build/release/reminders",
    "test": "bun test",
    "test:cleanup": "bun test/cleanup-test-lists.ts",
    "prettier-check": "prettier --check .",
    "prettier": "prettier --write .",
    "prettier:write:file": "prettier --write --ignore-unknown",
    "signal": "bun run prettier-check",
    "prepare": "husky",
    "setup-env": "bun scripts/setup-env.ts",
    "setup-env:swift": "bun scripts/setup-env-swift.ts",
    "signal:verbose": "bunx justin-sdk signal",
    "signal:serial": "bunx justin-sdk signal --serial",
    "doctor": "bunx justin-sdk doctor",
    "doctor:fix": "bunx justin-sdk doctor --fix",
    "signal-source:TS": "tsc --noEmit",
    "signal-source:LINT": "eslint --report-unused-disable-directives --max-warnings 0 .",
    "signal-source:PRETTIER": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "bun-types": "1.3.5",
    "husky": "9.1.7",
    "lint-staged": "^14.0.1",
    "prettier": "3.6.2"
  },
  "lint-staged": {
    "**/*": "prettier --check --ignore-unknown"
  },
  "trustedDependencies": [
    "@justinhaaheim/version-manager"
  ]
}
