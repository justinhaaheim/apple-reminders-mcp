{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(unzip:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git rebase:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(bun install:*)",
      "Bash(bun list:*)",
      "Bash(bun run:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(bun pm:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(bunx github:justinhaaheim/justin-sdk*)",
      "mcp__ide__getDiagnostics",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ],
    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["br"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then bunx github:justinhaaheim/justin-sdk setup-env; else bun run justin-sdk session-start || true; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bun run justin-sdk thread start --hook",
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"Claude Code - $(basename \"$PWD\")\" -subtitle \"Input Required\" -message \"Claude is waiting for your input\" -sound default"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read file_path; bun run prettier:write:file -- \"$file_path\"; }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bun run justin-sdk thread stop-check",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bun run justin-sdk thread capture",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bun run justin-sdk thread capture",
            "type": "command"
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": ["/Users/jhaa/.claude/rules/justin-sdk/critical-rules.md"]
}
