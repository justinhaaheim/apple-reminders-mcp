# Swift build artifacts
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace

# SQLite WAL/SHM siblings — created transiently when SQLite opens a DB
# in WAL mode, even read-only. Never commit; they're regenerated.
*.sqlite-wal
*.sqlite-shm

# macOS
.DS_Store

# Logs
*.log

# Node.js
node_modules/
bun.lockb

# Claude Code local settings (keep settings.json, ignore local)
.claude/settings.local.json

# Temp
/tmp

# Swift installer artifacts
swiftly
swiftly-*.tar.gz
LICENSE.txt

# Dolt database files (added by bd init)
.dolt/
*.db

# npm package binaries (built by CI)
npm/bin/reminders

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Temporary / scratch files
tmp/

# Dynamic version artifacts (local-only)
dynamic-version.local.json
dynamic-version.local.d.ts
